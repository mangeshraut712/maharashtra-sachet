PORT=8787
# Optional. Register at https://data.gov.in and paste the key to enable CPCB AQI.
DATA_GOV_IN_API_KEY=
# Optional. Register at https://api.imd.gov.in/public/index.php then whitelist this server IP.
IMD_API_KEY=
# Optional. Comma-separated Maharashtra cities for AQI cards.
AQI_CITIES=Mumbai,Navi Mumbai,Thane,Kalyan,Pune,Nagpur,Nashik,Aurangabad,Kolhapur,Solapur,Amravati,Chandrapur,Sangli,Akola,Jalgaon,Nanded,Latur,Vasai
# Optional. Set true locally to test USGS/FIRMS situational map layers (default off in production).
SITUATIONAL_LAYERS_ENABLED=false
# Optional NASA FIRMS MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=
# Shadow Jev triage (ops logs only; default off). Set JEV_SHADOW_KILL=true to halt quickly.
JEV_SHADOW_ENABLED=false
JEV_SHADOW_KILL=false
JEV_USE_LIVE=false
JEV_API_KEY=
# Cloudflare secret binding may be named `cursor` instead of JEV_API_KEY.
cursor=
# Optional override; default is https://api.typesafe.ai/v1/systemone (not /v1/score).
JEV_GATEWAY_URL=
